#!/usr/bin/env python3
"""Run the thesis_gs command line from a source checkout (no install needed)."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))
from thesis_gs.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
